{
  "name": "open-code-review-enhanced",
  "version": "0.1.1",
  "description": "OpenCodeReview CLI — AI-powered code review tool",
  "bin": {
    "ocr": "bin/ocr.js"
  },
  "files": [
    "bin/ocr.js",
    "scripts/install.js",
    "scripts/update.js",
    "scripts/version.js",
    "scripts/platform.js",
    "prompts/open-code-review-background.md",
    "imgs/"
  ],
  "scripts": {
    "postinstall": "node scripts/install.js",
    "test:github-actions": "node scripts/github-actions/post-review-comments.test.js && node scripts/github-actions/check-translation-sync.test.js && node scripts/github-actions/action-contract.test.js && node scripts/github-actions/check-plugin-contract.test.js",
    "test:viewer": "node --test scripts/viewer-actions.test.mjs",
    "test:update": "node scripts/version.test.js",
    "test:launcher": "node bin/ocr.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaye-Tao/open-code-review-enhanced.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "ocrConfig": {
    "urlPattern": "https://github.com/Jaye-Tao/open-code-review-enhanced/releases/download/v{version}/opencodereview-{os}-{arch}",
    "checksumPattern": "https://github.com/Jaye-Tao/open-code-review-enhanced/releases/download/v{version}/sha256sum.txt"
  },
  "optionalDependencies": {
    "open-code-review-enhanced-darwin-arm64": "0.1.1",
    "open-code-review-enhanced-darwin-x64": "0.1.1",
    "open-code-review-enhanced-linux-arm64": "0.1.1",
    "open-code-review-enhanced-linux-x64": "0.1.1",
    "open-code-review-enhanced-win32-arm64": "0.1.1",
    "open-code-review-enhanced-win32-x64": "0.1.1"
  },
  "engines": {
    "node": ">=14"
  },
  "license": "Apache-2.0"
}
